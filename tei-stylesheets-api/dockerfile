FROM eclipse-temurin:11-jre-jammy AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    ant \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch v7.60.0 https://github.com/TEIC/Stylesheets.git /stylesheets \
    && chmod +x /stylesheets/bin/*

FROM eclipse-temurin:11-jre-jammy

RUN apt-get update && apt-get install -y --no-install-recommends \
    ant \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3.13 python3.13-venv python3.13-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv
COPY --from=builder /stylesheets /app/stylesheets

ENV APPHOME=/app/stylesheets
ENV SAXONJAR=/app/stylesheets/lib/saxon10he.jar
ENV TRANGJAR=/app/stylesheets/lib/trang.jar
ENV PATH="/app/stylesheets/bin:${PATH}"

WORKDIR /app/api
COPY pyproject.toml uv.lock main.py ./
RUN uv sync --frozen

EXPOSE 8000
CMD ["uv", "run", "python", "main.py"]
